# Copy to .env and fill in. Never commit .env.
# Which LLM backend: mock (offline testing) | groq | bedrock | gemini | openrouter
LLM_PROVIDER=mock

# Study notes location (defaults to ./data/notes inside the repo)
NOTES_DIR=

# Groq (free tier) — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google AI Studio (free tier, no card) — https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenRouter (:free models, no card) — https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# AWS Bedrock — needs AWS creds (env/shared config) + model access in console
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# RAG knobs
RAG_TOP_K=4

# Web server
WEB_HOST=127.0.0.1
WEB_PORT=8000
